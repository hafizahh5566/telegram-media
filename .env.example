# Telegram Bot Token
# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# User Access Control (Optional)
# Leave empty to allow ALL users (public bot)
# Add comma-separated user IDs to restrict access
# Get your user ID from @userinfobot
# Examples:
# ALLOWED_USER_IDS=123456789
# ALLOWED_USER_IDS=123456789,987654321,555666777
ALLOWED_USER_IDS=

# Database Path (Optional)
# Default: database.db in project root
# DATABASE_PATH=./database.db

# Telegram Rate Limit (Optional)
# Delay between successful media sends. Increase this if Telegram returns 429.
# TELEGRAM_SEND_DELAY_MS=1200
# Maximum retries when Telegram returns 429/retry_after.
# TELEGRAM_MAX_RETRIES=5

# Forum Groups Feature
# The bot supports sending categories to Telegram Forum Groups (groups with topics)
# Requirements:
# - Bot must be admin in the forum group
# - Bot needs "Manage Topics" and "Send Messages" permissions
# - Group must have topics/forums enabled
# 
# Usage:
# /forum <category> <group_id>
# Example: /forum Movies -1001234567890
#
# The bot will automatically:
# - Check if the group is a forum
# - Create a topic named "📁 Category" (or use existing)
# - Send all media from that category to the topic
# - Cache topic IDs for future use
